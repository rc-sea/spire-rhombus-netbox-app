{
  "name": "spire-rhombus-netbox-app",
  "private": true,
  "version": "0.1.0",
  "description": "Bridge between the Spire Condominium's LenelS2 NetBox access control and Rhombus video, plus parking lobby displays.",
  "engines": {
    "node": "26.x",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
