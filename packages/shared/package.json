{
  "name": "@spire/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge event schema and validators shared by the collector and the cloud service.",
  "engines": {
    "node": "26.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
