# Copy to .env on the LAN host. Secrets go in ./secrets/, not here.
COLLECTOR_ID=spire-collector-1

# From Sequoyah. http:// or https://; include :port if the web server is not on 80/443.
NETBOX_BASE_URL=http://192.168.1.10
NETBOX_USERNAME=bridge-ro
# auto probes legacy paths then /nbws and accepts whatever GetAPIVersion reports.
NBAPI_VERSION=auto
NBAPI_PATH_FAMILY=auto
# raw (the guide's wording) or form (APIcommand= field) — change only if Sequoyah says so.
NBAPI_BODY_MODE=raw
# Only for an https NetBox with a self-signed certificate: mount the CA and point to it,
# or as a last resort NETBOX_TLS_INSECURE=true.
# NETBOX_CA_FILE=/run/secrets/netbox_ca

SITE_TIMEZONE=America/Los_Angeles

# The Vercel deployment of cloud/. CLOUD_SECRET (in secrets/) is `<collectorId>.<secret>`, see cloud/docs/api.md.
CLOUD_BASE_URL=https://spire-bridge.vercel.app

LOG_LEVEL=info
