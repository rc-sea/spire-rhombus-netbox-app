{
  "name": "@spire/collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "On-prem collector: reads LenelS2 NetBox activity over NBAPI and forwards it to the cloud bridge service.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@spire/shared": "workspace:*",
    "fast-xml-parser": "5.11.2",
    "pino": "10.4.0",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
